# ─── API Keys ──────────────────────────────────────────────────────────────

# OpenAI/LiteLLM API Key
OPENAI_API_KEY=your-openai-api-key-here

# ─── LiteLLM Configuration ─────────────────────────────────────────────────

# LiteLLM API Base URL
LITELLM_API_BASE=http://127.0.0.1:4000

# Default model to use
DEFAULT_MODEL=glm-5

# ─── MCP Server Configuration ──────────────────────────────────────────────

# MCP Server URL (single or multiple, comma-separated)
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Continue if MCP server fails to load
MCP_LOAD_FAIL_CONTINUE=true

# ─── PostgreSQL Configuration ──────────────────────────────────────────────

# Full database URL (optional, overrides individual settings)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Individual database settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deepagent
POSTGRES_PASSWORD=deepagent
POSTGRES_DB=deepagent

# ─── Application Configuration ─────────────────────────────────────────────

# Server settings
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true

# Logging
LOG_LEVEL=INFO

# ─── Sandbox Configuration ─────────────────────────────────────────────────

# OpenSandbox endpoint (optional)
OPENSANDBOX_ENDPOINT=http://localhost:8000

# Host directory for persistent sandbox output
SANDBOX_OUTPUT_HOST_DIR=./workspace
