# ─────────────────────────────────────────────────────────────────────────────
# DeepAgent Service - Production Environment
# ─────────────────────────────────────────────────────────────────────────────

# ─── API Keys ────────────────────────────────────────────────────────────────

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# GLM API Key (Zhipu AI)
GLM_API_KEY=your-glm-api-key

# Qwen API Key (Alibaba)
QWEN_API_KEY=your-qwen-api-key

# DeepSeek API Key
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── Database ────────────────────────────────────────────────────────────────

POSTGRES_USER=deepagent
POSTGRES_PASSWORD=change-this-to-a-secure-password
POSTGRES_DB=deepagent
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────

REDIS_PORT=6379

# ─── Application ─────────────────────────────────────────────────────────────

APP_PORT=8001
APP_DEBUG=false

# ─── LiteLLM ────────────────────────────────────────────────────────────────

LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-change-this-to-a-secure-key

# ─── MCP ────────────────────────────────────────────────────────────────────

MCP_PORT=8000

# ─── Default Model ──────────────────────────────────────────────────────────

DEFAULT_MODEL=glm-5
